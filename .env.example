# Database (composed into DATABASE_URL automatically)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
POSTGRES_DB=argus

# RabbitMQ (composed into CELERY_BROKER_URL automatically)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=argus
RABBITMQ_PASSWORD=argus
RABBITMQ_VHOST=
CELERY_RESULT_BACKEND=rpc://

# App
SECRET_KEY=change-me-to-a-random-secret
APP_ENV=development
LOG_LEVEL=info

# gRPC
GRPC_PORT=50051

# Notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@argus.local

# Slack webhook (optional)
SLACK_WEBHOOK_URL=

# GitHub token (for PR creation - Fase 2)
GITHUB_TOKEN=

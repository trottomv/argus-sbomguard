# Docker Compose
COMPOSE_FILE=docker-compose.development.yml
BUILD_TARGET=development
# always = pull from registry on every `up`; missing = pull only if image absent locally
PULL_POLICY=always
# Observability (optional trace dashboard — Jaeger)
# Start the Jaeger all-in-one service (dashboard at localhost:16686) with
# COMPOSE_PROFILES=jaeger (or --profile jaeger). Host ports 16686/4318 are
# published only in the local dev stack; on a remote host Jaeger stays
# internal-only (reachable from the compose network, dashboard not exposed).
# Still NOT recommended on production hosts: unauthenticated UI, in-memory
# trace storage. Prefer an external OTLP backend (OTEL_FORWARD_ENDPOINT) there.
COMPOSE_PROFILES=jaeger

# Database (composed into DATABASE_URL automatically)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
POSTGRES_DB=argus

# Backup (the 'backup' compose service runs scripts/backup.sh and restore.sh in
# an image based on the postgres image, with openssl added; the same image is
# used by a k8s CronJob — the scripts are ecosystem-agnostic)
# Host directory mounted at /backups in the backup container, and number of
# backups kept (0 = keep all). Point BACKUP_DIR at a path outside the repo for
# real deployments (absolute path).
BACKUP_DIR=./backups
BACKUP_RETENTION=7
# Optional backup encryption (AES-256-CBC + PBKDF2, 600000 iterations) with
# openssl in the backup container. Generate a dedicated key, independent from
# SECRET_KEY, with:
#   openssl rand -base64 32
# When set, backups are written encrypted (argus_*.sql.gz.enc); restore needs
# the same key. Leave empty for unencrypted backups. After changing any value
# above, recreate the backup container: docker compose up -d backup
# NOTE: openssl enc is NOT authenticated (no AEAD) — decryption + gzip -t catch
# accidental corruption but not deliberate tampering.
BACKUP_ENCRYPTION_KEY=

# RabbitMQ (composed into CELERY_BROKER_URL automatically)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=argus
RABBITMQ_PASSWORD=argus
RABBITMQ_VHOST=
CELERY_RESULT_BACKEND=rpc://

# App
# SECRET_KEY signs the session cookie. Generate a strong random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start if this is left at the default when APP_ENV != development.
SECRET_KEY=change-me-to-a-random-secret
# Valid values: development | demo | production (also used as the Docker image tag).
APP_ENV=development
# Tag of the GHCR image used by the remote stack (docker-compose.remote.yml)
APP_VERSION=0.0.10-beta
# Version of uv used to compile requirements and install them in the Docker image.
# PEP 440 specifier (~=0.12 = latest 0.12.x). Keep in sync across .env, justfile and CI.
UV_VERSION=~=0.12.0
# Version of pip installed system-wide in the Docker image (used to bootstrap uv).
# ~=26.2.0 installs only 26.2.x patches; minor/major upgrades are done manually.
PIP_VERSION=~=26.2.0
LOG_LEVEL=info
# Structured log output format: "json" (default) or "text".
LOG_FORMAT=json

# gRPC
GRPC_PORT=50051

# Allowed Host headers (Starlette TrustedHostMiddleware). Comma-separated exact
# hostnames, "*.domain" subdomain patterns, or "*" to allow any host (default;
# an empty value also means allow-all). Production deployments should pin this
# to their public host, e.g. ALLOWED_HOSTS=argus.example.com. The exact
# hostnames are also reused by the read-only MCP endpoint (see below).
ALLOWED_HOSTS=*

# Model Context Protocol (MCP) — read-only AI agent API at /api/v1/mcp.
# When enabled, AI agents (opencode / Claude Code) can query read-only tools
# (list_projects, list_sboms, get_sbom, ...) authenticated with an API key via
# `Authorization: Bearer` (no OAuth). Loopback hosts and DOMAIN are always
# allowed by the MCP endpoint; exact hostnames from ALLOWED_HOSTS are accepted
# too (bare hostname or with a port). Subdomain wildcards are not enforceable
# on the endpoint — use exact hostnames if you enable it.
MCP_ENABLED=false

# Observability (OpenTelemetry)
# /metrics is always served by the OTel Collector at /metrics (via Caddy) and
# exposes host metrics. The following control application-level tracing.
# Enable application trace push to the OTel Collector.
OTEL_TRACES_ENABLED=false
# Service name reported in the OpenTelemetry resource.
OTEL_SERVICE_NAME=argus-sbomguard
# OTLP/HTTP endpoint the application pushes traces to. The app always talks to
# the in-stack Collector (default), which is responsible for forwarding on.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# OTLP/HTTP endpoint where the Collector forwards traces. Defaults to the
# optional Jaeger dashboard (jaeger profile). In production, point this at an
# external OTLP backend (e.g. Logfire) instead of Jaeger.
OTEL_FORWARD_ENDPOINT=http://jaeger:4318
# Skip TLS verification when forwarding to the plaintext in-stack Jaeger.
# Set to false when OTEL_FORWARD_ENDPOINT is an external HTTPS backend.
OTEL_FORWARD_TLS_INSECURE=true

# Notifications (SMTP — Mailpit in dev: host=mailpit port=1025)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@argus.local

# Slack webhook (optional)
SLACK_WEBHOOK_URL=

# Discord webhook (optional)
DISCORD_WEBHOOK_URL=

# Default email recipients for alert notifications (comma-separated).
# Used when an alert config does not carry its own recipient(s).
ALERT_EMAIL_RECIPIENTS=

# Vulnerability rescan (Celery beat) — seconds between rescans of the latest SBOM
# of every service. Default 43200 (12h); e.g. 6h = 21600, 12h = 43200, 24h = 86400.
VULN_RESCAN_INTERVAL_SECONDS=43200

# Vulnerability snapshot retention (days, 30–180). Always on: the dashboard
# trend chart renders this window; older daily snapshot rows are pruned on each
# scheduled run.
SNAPSHOT_RETENTION_DAYS=30

# SBOM retention (days). SBOMs older than this are pruned, keeping at least the
# latest SBOM per service/project as a safety net. Set to 0 to keep SBOMs
# forever (an empty value also disables when injected via compose env_file).
SBOM_RETENTION_DAYS=365

# Auth
ADMIN_EMAIL=admin@argus.local
LOGIN_TOKEN_EXPIRE_MINUTES=15
SESSION_MAX_AGE_HOURS=1
# Default lifetime (days) of newly created API keys — forced rotation. New keys
# expire after this many days; set to 0 (or empty) for keys that never expire.
API_KEY_TTL_DAYS=90
# Surface the one-time login code directly in the login page response
# (dev/demo only). Rejected when APP_ENV=production.
SHOW_LOGIN_CODE_IN_RESPONSE=false

# Display timezone (used for displaying timestamps in the UI). Valid values: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DISPLAY_TIMEZONE=UTC

# Proxy (Caddy + Coraza WAF)
# Public hostname served by Caddy (TLS via Let's Encrypt) and used to build the
# absolute links in alert notifications. Default "localhost" (self-signed TLS).
DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@argus.local
# Rate limiting at the proxy edge (requests per 1-minute window), keyed per
# client IP (grouped by IPv6 /64 prefix).
# login: POST /login and /login/verify.
# api:   /api/v1/*.
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=120

# Resource limits (remote stack)
APP_MEM_LIMIT=512M
APP_CPU_LIMIT=1.0
WORKER_MEM_LIMIT=512M
WORKER_CPU_LIMIT=1.0
SCHEDULER_MEM_LIMIT=128M
SCHEDULER_CPU_LIMIT=0.5
PROXY_MEM_LIMIT=128M
PROXY_CPU_LIMIT=0.5

# Container logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# Database
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
POSTGRES_DB=argus
DATABASE_URL=postgresql+asyncpg://argus:argus@postgres:5432/argus

# RabbitMQ
RABBITMQ_USER=argus
RABBITMQ_PASSWORD=argus
CELERY_BROKER_URL=amqp://argus:argus@rabbitmq:5672//
CELERY_RESULT_BACKEND=rpc://

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# App
APP_SECRET_KEY=change-me-to-a-random-secret
APP_ENV=development
LOG_LEVEL=info

# Notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@argus.local

# Slack webhook (optional)
SLACK_WEBHOOK_URL=

# GitHub token (for PR creation - optional)
GITHUB_TOKEN=
